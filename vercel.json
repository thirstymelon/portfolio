{
  "redirects": [
    {
      "source": "/projects/esp32-mesh:ext(.*)",
      "destination": "/projects/meshos",
      "permanent": true
    },
    {
      "source": "/projects/radio-kit:ext(.*)",
      "destination": "/projects/radiokit",
      "permanent": true
    },
    {
      "source": "/projects/embedded-shell:ext(.*)",
      "destination": "/projects/radiokit",
      "permanent": true
    },
    {
      "source": "/projects/:slug.html",
      "destination": "/projects/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/glyph", "destination": "/Glyph.dc.html" },
    { "source": "/projects/glyph", "destination": "/Glyph.dc.html" },
    { "source": "/meshos", "destination": "/MeshOS.dc.html" },
    { "source": "/projects/meshos", "destination": "/MeshOS.dc.html" },
    { "source": "/radiokit", "destination": "/Radio_Kit.dc.html" },
    { "source": "/radio_kit", "destination": "/Radio_Kit.dc.html" },
    { "source": "/projects/radiokit", "destination": "/Radio_Kit.dc.html" },
    { "source": "/projects/radio-kit", "destination": "/Radio_Kit.dc.html" },
    { "source": "/home", "destination": "/Main.dc.html" },
    { "source": "/main", "destination": "/Main.dc.html" }
  ]
}
