---
// Anti-Flash Theme Init Script: applies the saved theme before the first paint.
// Kept in <head>, ahead of the stylesheets, so no page ever paints the wrong theme.
---
<script is:inline>
  (function () {
    function applySavedTheme() {
      var root = document.documentElement;
      var theme = localStorage.getItem('bento-theme');
      if (theme === 'light') {
        root.setAttribute('data-theme', 'light');
        root.classList.add('light-theme');
      } else {
        root.setAttribute('data-theme', 'dark');
        root.classList.remove('light-theme');
      }
    }
    applySavedTheme();
    document.addEventListener('astro:after-swap', applySavedTheme);
  })();
</script>
