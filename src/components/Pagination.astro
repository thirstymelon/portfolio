---
import type { Project } from '../data/projects';

interface Props {
  pager: {
    prev: Project;
    next: Project;
  };
}

const { pager } = Astro.props;
---
<footer class="project-pagination-section">
  <div class="pagination-container">
    <a href={`/projects/${pager.prev.slug}`} class="pagination-card prev">
      <span class="card-nav-dir">&larr; Previous Project</span>
      <span class="card-nav-title">{pager.prev.card_label}</span>
    </a>
    <a href={`/projects/${pager.next.slug}`} class="pagination-card next">
      <span class="card-nav-dir">Next Project &rarr;</span>
      <span class="card-nav-title">{pager.next.card_label}</span>
    </a>
  </div>
</footer>
