---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import '../styles/style.scss';

const meta = {
  title: '404 — Page Not Found | Lokesh Panditi',
  description: 'That page doesn\'t exist on this site. Head back to Lokesh Panditi\'s embedded systems and firmware portfolio.',
  og_title: '404 — Page Not Found',
  robots: 'noindex',
  theme_color: '#0b0b0d'
};
---
<BaseLayout {...meta}>
  <main class="main error-page">
    <Nav navTag="ERROR 404 • PAGE NOT FOUND" />

    <!-- BENTO CONTAINER: single full-bleed cell -->
    <div class="submain">
      <section class="error-box">
        <div class="card-pattern pattern-circuit">
          <div class="card-noise"></div>
          <svg class="pattern-svg static-svg" viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid slice" fill="none" stroke="currentColor">
            <g stroke-width="1.1" opacity="0.45">
              <!-- Grid lines -->
              <line x1="0" y1="100" x2="1000" y2="100" stroke-dasharray="6 8" />
              <line x1="0" y1="200" x2="1000" y2="200" />
              <line x1="0" y1="300" x2="1000" y2="300" stroke-dasharray="4 6" />
              <line x1="0" y1="400" x2="1000" y2="400" />
              <line x1="0" y1="500" x2="1000" y2="500" stroke-dasharray="8 8" />
              
              <line x1="150" y1="0" x2="150" y2="600" stroke-dasharray="4 8" />
              <line x1="300" y1="0" x2="300" y2="600" />
              <line x1="500" y1="0" x2="500" y2="600" stroke-dasharray="8 6" />
              <line x1="700" y1="0" x2="700" y2="600" />
              <line x1="850" y1="0" x2="850" y2="600" stroke-dasharray="4 6" />

              <!-- Circuit tracks & nodes -->
              <path d="M150 100 L250 100 L300 150 L500 150 L550 200 L700 200" />
              <path d="M300 400 L450 400 L500 450 L850 450" />
              <path d="M500 150 L500 300 L600 400 L700 400" />
              <path d="M150 500 L250 500 L350 400 L500 400" />

              <!-- Radar Concentric Rings in center-right -->
              <circle cx="720" cy="300" r="60" />
              <circle cx="720" cy="300" r="120" stroke-dasharray="6 6" />
              <circle cx="720" cy="300" r="180" />
              <circle cx="720" cy="300" r="240" stroke-dasharray="4 8" />
              
              <!-- Crosshairs & Pins -->
              <circle cx="150" cy="100" r="4" fill="currentColor" />
              <circle cx="300" cy="150" r="4" fill="currentColor" />
              <circle cx="500" cy="150" r="4" fill="currentColor" />
              <circle cx="700" cy="200" r="4" fill="currentColor" />
              <circle cx="450" cy="400" r="4" fill="currentColor" />
              <circle cx="850" cy="450" r="4" fill="currentColor" />
              <circle cx="720" cy="300" r="5" fill="currentColor" />
            </g>
          </svg>
          <svg class="pattern-svg flow-svg" viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid slice" fill="none" stroke="currentColor">
            <g stroke-width="1.8" class="circuit-flow-group">
              <line x1="0" y1="100" x2="1000" y2="100" stroke-dasharray="24 60" />
              <line x1="0" y1="200" x2="1000" y2="200" stroke-dasharray="30 80" />
              <line x1="0" y1="300" x2="1000" y2="300" stroke-dasharray="20 50" />
              <line x1="0" y1="400" x2="1000" y2="400" stroke-dasharray="36 70" />
              <line x1="0" y1="500" x2="1000" y2="500" stroke-dasharray="18 40" />

              <line x1="150" y1="0" x2="150" y2="600" stroke-dasharray="20 40" />
              <line x1="300" y1="0" x2="300" y2="600" stroke-dasharray="32 60" />
              <line x1="500" y1="0" x2="500" y2="600" stroke-dasharray="25 50" />
              <line x1="700" y1="0" x2="700" y2="600" stroke-dasharray="40 80" />
              <line x1="850" y1="0" x2="850" y2="600" stroke-dasharray="15 45" />

              <path d="M150 100 L250 100 L300 150 L500 150 L550 200 L700 200" stroke-dasharray="30 60" />
              <path d="M300 400 L450 400 L500 450 L850 450" stroke-dasharray="25 55" />
              <path d="M500 150 L500 300 L600 400 L700 400" stroke-dasharray="35 70" />
              <path d="M150 500 L250 500 L350 400 L500 400" stroke-dasharray="20 50" />

              <circle cx="720" cy="300" r="60" stroke-dasharray="16 32" />
              <circle cx="720" cy="300" r="120" stroke-dasharray="24 48" />
              <circle cx="720" cy="300" r="180" stroke-dasharray="36 60" />
              <circle cx="720" cy="300" r="240" stroke-dasharray="48 80" />
              
              <circle cx="150" cy="100" r="6" fill="currentColor" />
              <circle cx="300" cy="150" r="6" fill="currentColor" />
              <circle cx="500" cy="150" r="6" fill="currentColor" />
              <circle cx="700" cy="200" r="6" fill="currentColor" />
              <circle cx="450" cy="400" r="6" fill="currentColor" />
              <circle cx="850" cy="450" r="6" fill="currentColor" />
              <circle cx="720" cy="300" r="8" fill="currentColor" />
            </g>
          </svg>
        </div>

        <div class="error-inner">
          <div class="error-copy-side">
            <div class="error-code">404</div>
            <h1 class="error-title">Page not found</h1>

            <div class="cta-cluster">
              <a href="/" class="pill-btn" aria-label="Back to home" title="Back to home">
                <span>Back to home</span>
              </a>
              <a href="https://github.com/thirstymelon" class="circle-btn" target="_blank" rel="noopener"
                title="GitHub" aria-label="GitHub">
                <svg class="icon-github" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="pointer-events: none;">
                  <path
                    d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                </svg>
              </a>
              <a href="https://mail.google.com/mail/?view=cm&fs=1&to=lokesh.panditi.29@gmail.com" target="_blank" rel="noopener noreferrer" class="circle-btn" aria-label="Email via Gmail" title="Email via Gmail (lokesh.panditi.29@gmail.com)">
                <svg class="icon-mail" width="20" height="20" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="pointer-events: none;">
                  <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
                  <path d="M3 7l8.2 5.7a1.4 1.4 0 0 0 1.6 0L21 7" />
                </svg>
              </a>
            </div>
          </div>

          <figure class="error-gif-window" aria-hidden="true">
            <img id="errorGifImg" alt="404 Animation" loading="eager" decoding="async" />
          </figure>
        </div>
      </section>
    </div>
  </main>

  <Fragment slot="scripts">
    <script is:inline>
      (function() {
        function pickRandomGif() {
          var totalGifs = 22;
          var img = document.getElementById('errorGifImg');
          if (!img) return;
          var last = sessionStorage.getItem('last_404_gif');
          var chosen;
          do {
            chosen = Math.floor(Math.random() * totalGifs) + 1;
          } while (totalGifs > 1 && String(chosen) === last);
          sessionStorage.setItem('last_404_gif', String(chosen));
          var nextSrc = '/gifs/' + chosen + '.gif';
          if (img.getAttribute('src') !== nextSrc) {
            img.src = nextSrc;
          }
        }
        pickRandomGif();
        document.addEventListener('astro:page-load', pickRandomGif);
      })();
    </script>
  </Fragment>
</BaseLayout>
